{
  "version": 2,
  "builds": [
    {
      "src": "public/**",
      "use": "@vercel/static"
    },
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/auth/login",
      "dest": "/api/auth/login.js"
    },
    {
      "src": "/api/chat",
      "dest": "/api/chat.js"
    },
    {
      "src": "/api/learn",
      "dest": "/api/learn/index.js"
    },
    {
      "src": "/api/tools",
      "dest": "/api/tools/index.js"
    },
    {
      "src": "/api/admin/sources",
      "dest": "/api/admin/sources.js"
    },
    {
      "src": "/api/admin/env-status",
      "dest": "/api/admin/env-status.js"
    },
    {
      "src": "/api/admin/test",
      "dest": "/api/admin/test.js"
    },
    {
      "src": "/app.js",
      "dest": "/public/app.js"
    },
    {
      "src": "/login",
      "dest": "/public/login.html"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
